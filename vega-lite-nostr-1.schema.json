      "description": "select.nearest may be true only when the unit's mark is point (Vega-Lite ignores it on line/area and its compiler fails on bars with cornerRadius).",
      "if": {
        "not": {
          "properties": {
            "mark": {
              "anyOf": [
                {
                  "const": "point"
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "point"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "items": {
              "properties": {
                "select": {
                  "properties": {
                    "nearest": {
                      "const": false
                    }
